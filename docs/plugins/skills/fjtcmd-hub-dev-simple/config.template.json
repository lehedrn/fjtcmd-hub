{
  "_comment": "fjtcmd-hub-dev-simple 环境配置模板。复制为 config.json 并修改。",
  "_note": "或使用 verify_env.py --init 自动生成",

  "version": "1.1.0",
  "schema_version": 1,

  "database": {
    "host": "localhost",
    "port": 3306,
    "name": "fjtcmd_hub",
    "user": "root",
    "password": "",
    "dockerContainer": "mysql8",
    "charset": "utf8mb4"
  },

  "server": {
    "backendPort": 18081,
    "frontendPort": 3888
  },

  "generator": {
    "cliJarPath": "fjtcmd-hub-generator-cli/target/fjtcmd-hub-generator-cli.jar",
    "defaultAuthor": "fjtcmd",
    "defaultPackagePrefix": "com.fjtcmd.hub",
    "defaultTablePrefix": "sys_",
    "defaultTplWebType": "element-plus-typescript"
  },

  "paths": {
    "projectRoot": "",
    "requirementsBase": "docs/requirements",
    "generateBase": "generate"
  },

  "modules": {
    "available": ["demo", "biz"],
    "defaultTarget": "demo"
  }
}
