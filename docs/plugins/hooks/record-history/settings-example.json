{
  "_comment": "settings.local.json 配置示例",
  "_usage": "安装脚本会自动创建此配置，如需手动配置请参考",

  "permissions": {
    "allow": [
      "Bash(node .claude/hooks/record-history.js)"
    ]
  },

  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/record-history.js"
          }
        ]
      }
    ]
  }
}
