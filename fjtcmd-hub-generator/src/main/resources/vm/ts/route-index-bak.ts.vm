// ============================================================
// 子表路由配置（需要手动插入到 router/index.ts 的 dynamicRoutes 中）
// ============================================================
//
// 使用说明：
// 1. 打开 src/router/index.ts 文件
// 2. 找到 dynamicRoutes 数组
// 3. 将以下内容复制到 dynamicRoutes 数组中
// 4. 保存文件
//
// 生成时间: ${datetime}
// 主表: ${functionName} (${tableName})
// 子表: ${table.subTableConfig.functionName} (${table.subTableConfig.className})
// ============================================================

// ${functionName} - ${table.subTableConfig.functionName}管理
{
  path: '/${moduleName}/${table.subTableConfig.subRoute}',
  component: Layout,
  hidden: true,
  permissions: ['${permissionPrefix}:${table.subTableConfig.permissionPrefix}:list'],
  children: [
    {
      path: 'index/:${table.subTableConfig.fkJavaField}(\\d+)',
      component: () => import('@/views/${moduleName}/${table.subTableConfig.businessName}/index.vue'),
      name: '${table.subTableConfig.className}',
      meta: {
        title: '${table.subTableConfig.functionName}管理',
        activeMenu: '/${moduleName}/${businessName}'
      }
    }
  ]
}
